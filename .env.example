# tailwatch secrets. Never commit this file.

# One model provider is enough. Several keys for one provider can be comma-separated
# (or KEY_1, KEY_2, ...): a rate limit moves to the next key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional, free: raises GitHub's rate limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=
# Optional, free: a higher Semantic Scholar rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# Optional, paid (connectors are off until you turn them on in tailwatch.yaml).
EXA_API_KEY=
TWITTERAPI_IO_KEY=
APIFY_API_KEY=
# APIFY_LINKEDIN_ACTOR=

# Optional: Slack (Socket Mode, no public URL needed). See deploy/slack-manifest.yaml.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
